<Project Sdk="Microsoft.NET.Sdk">

  <!-- Small Windows UI to send commands to the transmitter (Arduino version over USB,
       or C# nanoFramework version over Bluetooth). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Remote</RootNamespace>
    <AssemblyTitle>nanoBrick remote</AssemblyTitle>
    <ApplicationIcon>nanobrick.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="nanobrick.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
  </ItemGroup>

</Project>
