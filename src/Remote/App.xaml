<Application x:Class="Remote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Remote"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== Palette ===== -->
        <Color x:Key="OrangeColor">#FF7A3C</Color>
        <Color x:Key="BlueColor">#2F9BD6</Color>
        <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
        <SolidColorBrush x:Key="DarkOrangeBrush" Color="#E0602A" />
        <SolidColorBrush x:Key="OrangeTintBrush" Color="#FFF1E8" />
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
        <SolidColorBrush x:Key="BlueTintBrush" Color="#E7F4FB" />
        <SolidColorBrush x:Key="RedBrush" Color="#E5484D" />
        <SolidColorBrush x:Key="GreenBrush" Color="#2EB67D" />
        <SolidColorBrush x:Key="InkBrush" Color="#1E2433" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="LineBrush" Color="#E3E6EC" />
        <SolidColorBrush x:Key="SoftBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="GreyBrush" Color="#C9CCD1" />
        <SolidColorBrush x:Key="DarkGreyBrush" Color="#8D9298" />
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#232838" Offset="0" />
            <GradientStop Color="#363D55" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F6FA" Offset="0" />
            <GradientStop Color="#E9EDF4" Offset="1" />
        </LinearGradientBrush>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.13" Color="#1E2433" />
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#1E2433" />

        <!-- ===== One template for every flat button: background + light overlay on hover, dark on press ===== -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="ButtonBase">
            <Grid>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding local:Ui.CornerRadius}" />
                <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="{TemplateBinding local:Ui.CornerRadius}" />
                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.18" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Overlay" Property="Background" Value="Black" />
                    <Setter TargetName="Overlay" Property="Opacity" Value="0.14" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="FlatButton" TargetType="ButtonBase">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Main call to action: orange pill -->
        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource OrangeBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="local:Ui.CornerRadius" Value="20" />
        </Style>

        <!-- Transparent until hovered (✕, refresh, status…) -->
        <Style x:Key="GhostButton" TargetType="ButtonBase" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="local:Ui.CornerRadius" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Round − / + "wheel" buttons -->
        <Style x:Key="WheelButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="local:Ui.CornerRadius" Value="27" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF9258" Offset="0" />
                        <GradientStop Color="#F26A2E" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>

        <!-- Battery box arrows, held down -->
        <Style x:Key="HoldButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="local:Ui.CornerRadius" Value="14" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#45AEE6" Offset="0" />
                        <GradientStop Color="#2489C4" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource RedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="local:Ui.CornerRadius" Value="12" />
        </Style>

        <Style x:Key="StopAllButton" TargetType="Button" BasedOn="{StaticResource StopButton}">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="local:Ui.CornerRadius" Value="23" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#E5484D" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ⟲ reverse toggle -->
        <Style x:Key="ReverseToggle" TargetType="ToggleButton" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Content" Value="&#xE8EE;" />
            <Setter Property="Background" Value="{StaticResource SoftBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="local:Ui.CornerRadius" Value="20" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource InkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented choice (USB / Bluetooth, notches per click) -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="local:Ui.CornerRadius" Value="16" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                    <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkSegmentRadio" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
            <Setter Property="Foreground" Value="#AEB5C6" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#4A526C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Rounded text box -->
        <Style x:Key="RoundTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource OrangeBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== Drawings (x:Shared=False: a new copy each time one is used) ===== -->

        <!-- nanoBrick logo: an orange brick with 2 studs -->
        <Viewbox x:Key="BrickLogo" x:Shared="False">
            <Canvas Width="40" Height="30">
                <Rectangle Canvas.Left="8" Canvas.Top="2" Width="9" Height="8" RadiusX="2" RadiusY="2" Fill="#E0602A" />
                <Rectangle Canvas.Left="23" Canvas.Top="2" Width="9" Height="8" RadiusX="2" RadiusY="2" Fill="#E0602A" />
                <Rectangle Canvas.Left="2" Canvas.Top="8" Width="36" Height="20" RadiusX="4" RadiusY="4" Fill="#FF7A3C" />
                <Rectangle Canvas.Left="2" Canvas.Top="8" Width="36" Height="5" RadiusX="3" RadiusY="3" Fill="#FF9A66" />
            </Canvas>
        </Viewbox>

        <!-- Grey remote with 2 orange wheels -->
        <Viewbox x:Key="GreyRemoteIcon" x:Shared="False">
            <Canvas Width="48" Height="40">
                <Rectangle Canvas.Left="2" Canvas.Top="6" Width="44" Height="28" RadiusX="12" RadiusY="12" Fill="#C9CCD1" Stroke="#8D9298" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="7" Canvas.Top="11" Width="14" Height="18" Fill="#FF7A3C" Stroke="#E0602A" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="27" Canvas.Top="11" Width="14" Height="18" Fill="#FF7A3C" Stroke="#E0602A" StrokeThickness="1.5" />
                <Rectangle Canvas.Left="9" Canvas.Top="17" Width="10" Height="2" Fill="#E0602A" />
                <Rectangle Canvas.Left="9" Canvas.Top="21" Width="10" Height="2" Fill="#E0602A" />
                <Rectangle Canvas.Left="29" Canvas.Top="17" Width="10" Height="2" Fill="#E0602A" />
                <Rectangle Canvas.Left="29" Canvas.Top="21" Width="10" Height="2" Fill="#E0602A" />
            </Canvas>
        </Viewbox>

        <!-- Battery box with outputs A–D and its orange button -->
        <Viewbox x:Key="BatteryBoxIcon" x:Shared="False">
            <Canvas Width="48" Height="40">
                <Rectangle Canvas.Left="6" Canvas.Top="3" Width="36" Height="34" RadiusX="6" RadiusY="6" Fill="#C9CCD1" Stroke="#8D9298" StrokeThickness="1.5" />
                <Ellipse Canvas.Left="19" Canvas.Top="8" Width="10" Height="10" Fill="#FF7A3C" Stroke="#E0602A" StrokeThickness="1.2" />
                <Rectangle Canvas.Left="11" Canvas.Top="24" Width="5" Height="7" RadiusX="1" RadiusY="1" Fill="#2F9BD6" />
                <Rectangle Canvas.Left="18" Canvas.Top="24" Width="5" Height="7" RadiusX="1" RadiusY="1" Fill="#2F9BD6" />
                <Rectangle Canvas.Left="25" Canvas.Top="24" Width="5" Height="7" RadiusX="1" RadiusY="1" Fill="#2F9BD6" />
                <Rectangle Canvas.Left="32" Canvas.Top="24" Width="5" Height="7" RadiusX="1" RadiusY="1" Fill="#2F9BD6" />
            </Canvas>
        </Viewbox>
    </Application.Resources>
</Application>
