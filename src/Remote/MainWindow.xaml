<Window x:Class="Remote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="nanoBrick — remote (4 receivers + battery box)" Width="900" Height="860" MinWidth="700" MinHeight="600"
        Background="#EEF0F3" FontFamily="Segoe UI" FontSize="14"
        KeyDown="OnKeyDown" Closing="OnClosing">
    <DockPanel Margin="8">

        <!-- Connection -->
        <GroupBox Header="Connection to the transmitter" DockPanel.Dock="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SerialOption" Content="USB cable (Arduino transmitter)" IsChecked="True"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="PortList" Width="90" Margin="0,0,4,0" />
                    <Button Content="↻" ToolTip="Refresh the port list" Click="OnRefreshPorts" Padding="8,2" />
                    <RadioButton x:Name="BluetoothOption" Content="Bluetooth &quot;NanoBrick&quot; (C# firmware)"
                                 VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ConnectButton" Content="Connect" Width="130" Click="OnConnectClick" />
                    <Ellipse x:Name="StatusLight" Width="12" Height="12" Fill="{StaticResource DarkGreyBrush}" Margin="8,0" />
                    <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Settings -->
        <GroupBox Header="Settings" DockPanel.Dock="Top">
            <WrapPanel x:Name="SettingsPanel" IsEnabled="False">
                <TextBlock Text="Notches per click:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="StepsPerClick" Width="60" SelectedIndex="1">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="10" />
                </ComboBox>
                <TextBlock Text="Receivers present:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="PresentReceivers" Width="90" SelectedIndex="0" SelectionChanged="OnPresentReceiversChanged">
                    <ComboBoxItem Content="1" Tag="1" />
                    <ComboBoxItem Content="1 and 2" Tag="12" />
                    <ComboBoxItem Content="1 to 3" Tag="123" />
                    <ComboBoxItem Content="1 to 4" Tag="1234" />
                </ComboBox>
                <TextBlock Text="Power:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="PowerLevel" Width="170" SelectedIndex="0" SelectionChanged="OnPowerLevelChanged">
                    <ComboBoxItem Content="−18 dBm (recommended)" />
                    <ComboBoxItem Content="−12 dBm" />
                    <ComboBoxItem Content="−6 dBm" />
                    <ComboBoxItem Content="0 dBm (saturates nearby)" />
                </ComboBox>
                <Button Content="Status" ToolTip="Ask the transmitter for its status (command f)" Click="OnStatusClick" Margin="16,4,4,4" />
                <Button Content="STOP ALL" Style="{StaticResource StopButton}" Click="OnStopAllClick"
                        ToolTip="Stop every output (Space)" />
            </WrapPanel>
        </GroupBox>

        <!-- 4-output battery box (white remote): outputs built in code -->
        <GroupBox DockPanel.Dock="Top" Background="{StaticResource GreyBrush}">
            <GroupBox.Header>
                <TextBlock FontWeight="SemiBold"
                           Text="4-output battery box (white remote) — hold the button, full speed" />
            </GroupBox.Header>
            <UniformGrid x:Name="BatteryBoxPanel" Columns="4" IsEnabled="False" />
        </GroupBox>

        <!-- Log -->
        <GroupBox Header="Log" DockPanel.Dock="Bottom" Height="160">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Send" Click="OnSendRawCommand" IsDefault="True" Margin="4,0,0,0" />
                    <TextBox x:Name="RawCommand" VerticalContentAlignment="Center" FontFamily="Consolas"
                             ToolTip="Any command: 2a+ 3, 4sb, x, k 1, m 12, p 0, f…" />
                </DockPanel>
                <ListBox x:Name="Log" FontFamily="Consolas" FontSize="12" />
            </DockPanel>
        </GroupBox>

        <!-- The 4 receivers (built in code) -->
        <UniformGrid x:Name="ReceiversPanel" Columns="2" IsEnabled="False" />
    </DockPanel>
</Window>
