<Window x:Class="Remote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Remote"
        Title="nanoBrick — remote" Width="980" Height="880" MinWidth="560" MinHeight="600"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{StaticResource InkBrush}" UseLayoutRounding="True" Icon="nanobrick.ico"
        KeyDown="OnKeyDown" Closing="OnClosing">
    <DockPanel>

        <!-- ===== Header: logo + connection ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{StaticResource BrickLogo}" Width="72" Height="51" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <ContentControl Content="{StaticResource Wordmark}" Height="22" HorizontalAlignment="Left" />
                        <TextBlock Text="remote control for your models" Foreground="#9AA3B8" FontSize="12" Margin="1,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#2B3144" CornerRadius="18" Padding="3" Margin="0,4,10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SerialOption" Style="{StaticResource DarkSegmentRadio}" IsChecked="True"
                                         ToolTip="USB cable (Arduino transmitter)" Checked="OnConnectionKindChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="USB" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BluetoothOption" Style="{StaticResource DarkSegmentRadio}"
                                         ToolTip="Bluetooth &quot;NanoBrick&quot; (C# firmware)" Checked="OnConnectionKindChanged">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Bluetooth" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="PortPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,10,4">
                        <ComboBox x:Name="PortList" Width="86" Height="30" VerticalContentAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" ToolTip="Refresh the port list" Click="OnRefreshPorts"
                                Foreground="#C9D0E0" Margin="2,0,0,0">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
                        </Button>
                    </StackPanel>
                    <Border x:Name="StatusPill" Background="#2B3144" CornerRadius="16" Padding="12,6" Margin="0,4,10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusLight" Width="10" Height="10" Fill="{StaticResource DarkGreyBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Not connected" Foreground="#DDE2EC" Margin="8,0,0,0"
                                       MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ConnectButton" Style="{StaticResource PillButton}" Content="Connect" MinWidth="120"
                            Click="OnConnectClick" Margin="0,4" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="16,16,16,4" Padding="16,10" CornerRadius="16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource StopAllButton}" Click="OnStopAllClick"
                        x:Name="StopAllButton" IsEnabled="False" ToolTip="Stop every output (Space)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="STOP ALL" />
                    </StackPanel>
                </Button>
                <WrapPanel x:Name="SettingsPanel" VerticalAlignment="Center">
                    <TextBlock Text="NOTCHES PER CLICK" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                    <Border Background="{StaticResource SoftBrush}" CornerRadius="18" Padding="3" Margin="0,4,20,4">
                        <StackPanel x:Name="StepsPanel" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="1" Tag="1" GroupName="Steps" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="3" Tag="3" GroupName="Steps" IsChecked="True" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="5" Tag="5" GroupName="Steps" />
                            <RadioButton Style="{StaticResource SegmentRadio}" Content="10" Tag="10" GroupName="Steps" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="POWER" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                    <ComboBox x:Name="PowerLevel" Width="190" Height="30" VerticalContentAlignment="Center" SelectedIndex="0"
                              SelectionChanged="OnPowerLevelChanged" Margin="0,4,12,4">
                        <ComboBoxItem Content="−18 dBm (recommended)" />
                        <ComboBoxItem Content="−12 dBm" />
                        <ComboBoxItem Content="−6 dBm" />
                        <ComboBoxItem Content="0 dBm (saturates nearby)" />
                    </ComboBox>
                    <Button x:Name="StatusButton" Style="{StaticResource GhostButton}" Click="OnStatusClick" IsEnabled="False"
                            ToolTip="Ask the transmitter for its status (command f)" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Status" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== Console (log + raw command), collapsible ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource InkBrush}" CornerRadius="16" Margin="16,4,16,16" Padding="14,8">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <ToggleButton x:Name="ConsoleToggle" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Foreground="#C9D0E0"
                                  Checked="OnConsoleToggled" Unchecked="OnConsoleToggled" Padding="4,4,10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConsoleChevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="CONSOLE" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock x:Name="LastLogLine" Foreground="#7F889C" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                </DockPanel>
                <DockPanel x:Name="ConsoleBody" Visibility="Collapsed" Margin="0,8,0,2">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Send" Click="OnSendRawCommand"
                                IsDefault="True" Margin="8,0,0,0" Padding="18,7" />
                        <TextBox x:Name="RawCommand" Style="{StaticResource RoundTextBox}" FontFamily="Consolas"
                                 Background="#2B3144" Foreground="White" BorderBrush="#3A4259" CaretBrush="White"
                                 ToolTip="Any command: 2a+ 3, 4sb, x, k 1, m 12, p 0, f…" />
                    </DockPanel>
                    <ListBox x:Name="Log" Height="130" Background="Transparent" BorderThickness="0" Foreground="#C9D0E0"
                             FontFamily="Consolas" FontSize="12" />
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ===== The garage: one card per remote, then the "add" tile ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
            <StackPanel>
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" Margin="0,36,0,12">
                    <ContentControl Content="{StaticResource BrickLogo}" Width="124" Height="88" />
                    <TextBlock Text="Your garage is empty" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="Add a remote for each receiver or battery box you want to drive."
                               Foreground="{StaticResource MutedBrush}" FontSize="15" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="ConnectHint" Text="Connect the transmitter to drive your models"
                           Foreground="{StaticResource MutedBrush}" FontStyle="Italic" Margin="12,6,12,0" />

                <WrapPanel x:Name="RemotesPanel" Margin="0,4,0,8">
                    <Button x:Name="AddRemoteButton" Click="OnAddRemoteClick" Width="210" Height="190" Margin="8"
                            Cursor="Hand" ToolTip="Add a remote: grey remote (receiver 1–4) or white remote (battery box)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Rectangle x:Name="Dash" RadiusX="18" RadiusY="18" Stroke="#B8BEC9" StrokeThickness="2"
                                               StrokeDashArray="4 3" Fill="#66FFFFFF" />
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border x:Name="Plus" Width="56" Height="56" CornerRadius="28" Background="{StaticResource OrangeBrush}"
                                                Effect="{StaticResource SoftShadow}" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="PlusScale" />
                                            </Border.RenderTransform>
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Add a remote" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                        <TextBlock Text="receiver or battery box" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource OrangeBrush}" />
                                        <Setter TargetName="Dash" Property="Fill" Value="{StaticResource OrangeTintBrush}" />
                                        <Setter TargetName="Plus" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Plus" Property="Background" Value="{StaticResource DarkOrangeBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
